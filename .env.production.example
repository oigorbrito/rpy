# Copy to a secret-managed environment source. Do not commit populated values.
# Production must deploy one already-built application artifact by registry digest.
RPY_IMAGE=ghcr.io/oigorbrito/rpy@sha256:replace-with-64-hex-digest

POSTGRES_DB=rpy
POSTGRES_USER=rpy
POSTGRES_PASSWORD=replace-with-strong-postgres-password

# Database credentials are intentionally split by responsibility. Runtime services
# must never receive the migration/admin credential.
MIGRATION_DATABASE_URL=postgresql://rpy:replace-with-url-encoded-migration-password@postgres:5432/rpy
API_DATABASE_URL=postgresql://rpy_api:replace-with-url-encoded-api-password@postgres:5432/rpy
WORKER_DATABASE_URL=postgresql://rpy_worker:replace-with-url-encoded-worker-password@postgres:5432/rpy
SCHEDULER_DATABASE_URL=postgresql://rpy_scheduler:replace-with-url-encoded-scheduler-password@postgres:5432/rpy
BACKUP_DATABASE_URL=postgresql://rpy_backup:replace-with-url-encoded-backup-password@postgres:5432/rpy

ANTHROPIC_API_KEY=replace-with-anthropic-key
OPENAI_API_KEY=replace-with-openai-key
EMBEDDING_MODEL=text-embedding-3-small

# Outbound Judit requests use this provider credential. It is never exposed to browsers.
JUDIT_API_KEY=replace-with-judit-api-key
JUDIT_TIMEOUT_SECONDS=15
JUDIT_WEBHOOK_TOKEN=replace-with-long-random-token
JUDIT_WEBHOOK_MAX_BODY_BYTES=5242880
# Single-tenant deployments: processes ingested through the Judit webhook are
# bound to this tenant's authorized portfolio automatically. Leave unset to keep
# ingestion decoupled from authorization (populate tenant_processes explicitly).
JUDIT_WEBHOOK_TENANT_ID=
# Bulk/bootstrapping portfolio (optional). JSON mapping tenant UUID -> CNJ codes.
# Consumed by scripts/seed_carteira.py, and validated at API startup.
RPY_TENANT_PROCESSES={}
RPY_OPS_TOKEN=replace-with-long-random-ops-token

ANTHROPIC_TIMEOUT_SECONDS=15
EMBEDDING_TIMEOUT_SECONDS=15
PROVIDER_MAX_ATTEMPTS=2
PROVIDER_RETRY_BACKOFF_SECONDS=0.25
# Deterministic character budgets applied before any external generation call.
PROVIDER_PROMPT_MAX_CHARS=120000
PROVIDER_STEP_TEXT_MAX_CHARS=12000
PROVIDER_STEPS_TEXT_MAX_CHARS=80000
WORKER_TASK_TIMEOUT_SECONDS=120
# Worker stops claiming immediately, but lets already-claimed jobs finish for this long.
WORKER_SHUTDOWN_GRACE_SECONDS=30
# Must remain greater than WORKER_SHUTDOWN_GRACE_SECONDS so Docker does not SIGKILL first.
WORKER_STOP_GRACE_PERIOD=40s

RETENTION_DAYS=365
JOB_RETENTION_DAYS=30

# Operational alert thresholds consumed by /ops/metrics. These do not affect /ready.
OPS_BACKUP_MAX_AGE_SECONDS=93600
OPS_QUEUE_WARN_SECONDS=300
OPS_QUEUE_CRITICAL_SECONDS=1800
OPS_STALE_PROCESSING_SECONDS=60
OPS_DEAD_JOBS_WARN_24H=1
OPS_DEAD_JOBS_CRITICAL_24H=5
OPS_GENERATION_P95_WARN_MS=60000
OPS_GENERATION_P95_CRITICAL_MS=120000

# Safe default for a same-host reverse proxy. Change only when the ingress topology requires it.
RPY_API_BIND_ADDRESS=127.0.0.1
RPY_API_PORT=8000
